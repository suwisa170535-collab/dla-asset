@echo off
chcp 65001 > nul
title ตั้งค่าให้ระบบเริ่มทำงานอัตโนมัติเมื่อเปิดคอมพิวเตอร์
echo ================================================================================
echo 🏛️  ตั้งค่าให้ระบบครุภัณฑ์ทำงานอัตโนมัติทันทีที่เปิดเครื่องแม่ (Auto-Start)
echo ================================================================================
echo.
echo ฟังก์ชันนี้จะช่วยให้:
echo 1. เมื่อเปิดคอมพิวเตอร์เครื่องแม่ ระบบฐานข้อมูลจะ "เริ่มทำงานอยู่เบื้องหลังทันที"
echo 2. หัวหน้าพัสดุไม่ต้องคอยจำว่าต้องมากดดับเบิ้ลคลิกเปิดโปรแกรมทุกเช้า
echo 3. เครื่องลูกและมือถือทั่วเทศบาลสามารถเชื่อมต่อเข้ามาใช้งานได้ทันที
echo.
echo --------------------------------------------------------------------------------

set DIR=%~dp0
set STARTUP_DIR=%APPDATA%\Microsoft\Windows\Start Menu\Programs\Startup
set VBS_LAUNCHER=%STARTUP_DIR%\เริ่มระบบครุภัณฑ์_อัตโนมัติ.vbs

:: สร้าง VBScript ในโฟลเดอร์ Startup เพื่อรัน node server เงียบๆ ไม่รบกวนหน้าจอ
echo Set WshShell = CreateObject("WScript.Shell") > "%VBS_LAUNCHER%"
echo WshShell.CurrentDirectory = "%DIR%" >> "%VBS_LAUNCHER%"
echo WshShell.Run "cmd /c node server/index.js", 0, False >> "%VBS_LAUNCHER%"

echo.
echo ================================================================================
echo 🎉 ตั้งค่าสำเร็จเรียบร้อยแล้ว!
echo.
echo    ✅ คัดลอกการตั้งค่าเข้า Windows Startup เรียบร้อย
echo    👉 ต่อไปนี้ เพียงแค่เปิดคอมพิวเตอร์เครื่องแม่ทิ้งไว้ ระบบจะทำงานเองอัตโนมัติทันที
echo       (แม้ไม่ได้กดเปิดโปรแกรม เครื่องลูกทั่วสำนักงานก็สามารถเข้าใช้งานได้ 100%)
echo ================================================================================
echo.
pause

